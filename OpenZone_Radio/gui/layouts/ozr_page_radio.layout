// Сторінка «Рація»: канали ліворуч, стан ефіру праворуч.
//
// Кладеться скриптом у PageHost меню (1045x414 одиниць розмітки).
// Імена читає OZR_PageRadio.c: ChannelList, BtnTune, BtnTuneText, RadioTitle,
// RadioBand, RadioPower, RadioAntenna, RadioLive, RadioHint.

FrameWidgetClass OZ_PageRadio {
 visible 1
 position 0 0
 size 1045 414
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  // --- ліва колонка: канали ---
  TextListboxWidgetClass ChannelList {
   visible 1
   position 16 12
   size 380 356
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style NoScrollBar
   "title visible" 0
   "highlight row" 1
   colums "text;100;"
   lines 14
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 13
   color 0.788 0.788 0.816 1
   priority 2
  }

  // БЕЗ style "DayZButton": стиль малює власну графіку ПОВЕРХ дочірніх
  // віджетів, і напис усередині зникає.
  ButtonWidgetClass BtnTune {
   visible 1
   position 16 376
   size 380 26
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text ""
   priority 3
   {
    PanelWidgetClass BtnTuneBg {
     visible 1
     ignorepointer 1
     color 0.145 0.145 0.161 1
     position 0 0
     size 380 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     priority 1
     style rover_sim_colorable
    }
    TextWidgetClass BtnTuneText {
     visible 1
     ignorepointer 1
     position 0 0
     size 380 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 1 0.478 0.102 1
     text ""
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 13
     "text halign" center
     "text valign" center
     priority 2
    }
   }
  }

  // --- права колонка: ефір ---
  TextWidgetClass RadioTitle {
   visible 1
   ignorepointer 1
   position 412 12
   size 617 26
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 1 0.478 0.102 1
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 18
   "text halign" left
   "text valign" center
   priority 2
  }

  TextWidgetClass RadioBand {
   visible 1
   ignorepointer 1
   position 412 44
   size 617 22
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.788 0.788 0.816 1
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 14
   "text halign" left
   "text valign" center
   priority 2
  }

  TextWidgetClass RadioPower {
   visible 1
   ignorepointer 1
   position 412 92
   size 617 20
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.788 0.788 0.816 1
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 13
   "text halign" left
   "text valign" center
   priority 2
  }

  TextWidgetClass RadioAntenna {
   visible 1
   ignorepointer 1
   position 412 114
   size 617 20
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.788 0.788 0.816 1
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 13
   "text halign" left
   "text valign" center
   priority 2
  }

  // Велике й помітне: поки горить, тебе чують. Це єдине, що гравець мусить
  // побачити не читаючи.
  TextWidgetClass RadioLive {
   visible 1
   ignorepointer 1
   position 412 180
   size 617 40
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 1 0.478 0.102 1
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 24
   "text halign" left
   "text valign" center
   priority 2
  }

  TextWidgetClass RadioHint {
   visible 1
   ignorepointer 1
   position 412 378
   size 617 24
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.463 0.463 0.494 1
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 13
   "text halign" left
   "text valign" center
   priority 2
  }
 }
}
